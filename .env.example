NODE_ENV=development
HOST=127.0.0.1
PORT=3000
UPSTREAM_API_BASE_URL=
UPSTREAM_X_TOKEN=
UPSTREAM_USER_NAME=
UPSTREAM_SECONDARY_API_BASE_URL=
UPSTREAM_SECONDARY_X_TOKEN=
UPSTREAM_SECONDARY_USER_NAME=
UPSTREAM_CREDENTIALS_FILE=./data/upstream-credentials.json
WORKSPACE_FILE=./data/workspace.json
# production 必填：独立的数据源维护二次密码，不得复用普通账号密码或上游 Token。
TOKEN_MAINTENANCE_KEY=
# 正式公网环境必须使用 local，并配置独立的账号库、随机 CSRF secret 和 HTTPS Origin。
# 账号库与遗留工作区 DATABASE_URL 分开，避免启用登录时顺带迁移旧工作区。
BI_IDENTITY_MODE=unavailable
BI_AUTH_DATABASE_URL=
BI_AUTH_CSRF_SECRET=
BI_PUBLIC_ORIGIN=
# 核心经营总览批量查询默认关闭；只有真实执行器、9 项数据准入和发布门槛全部完成后才可开启。
BI_V2_CORE_OVERVIEW_QUERY_ENABLED=false
# 正式日看板真实查询开关。production 仅在反向代理、登录、PID 权限和上游地址均配置后开启。
BI_DAILY_DASHBOARD_QUERY_ENABLED=false
# 旧的本地联调兼容开关；仅允许 development/test + 127.0.0.1，新部署使用上面的正式开关。
BI_LOCAL_DASHBOARD_READING_ENABLED=false
DATABASE_URL=
REQUEST_TIMEOUT_MS=10000
MAX_PLATFORM_CONCURRENCY=4
