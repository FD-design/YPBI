187.77.129.207.nip.io {
    log {
        format filter {
            request>uri regexp "\\?.*$" "?REDACTED"
            request>headers>Referer delete
            request>headers>Cookie delete
            request>headers>Authorization delete
            request>headers>X-Csrf-Token delete
        }
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Start with one day. Increase to one year only after the HTTPS-only
        # topology has passed production rollback and certificate checks.
        Strict-Transport-Security "max-age=86400"
    }

    handle /api/* {
        # Nginx is loopback-only and applies the standard-module rate limits
        # and public API allowlist before Fastify receives the request.
        reverse_proxy 127.0.0.1:5178 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_down Cache-Control "no-store"
        }
    }

    handle {
        root * /opt/config-driven-bi-demo/dist
        try_files {path} /index.html
        file_server
    }
}
