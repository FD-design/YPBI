[Unit]
Description=NewAV BI API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/newav-bi
EnvironmentFile=/opt/newav-bi/.env.local
ExecStart=/root/.bun/bin/bun server/index.ts
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
