[Unit]
Description=Config Driven BI Web
After=network-online.target config-driven-bi-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/config-driven-bi-demo
ExecStart=/root/.bun/bin/bun run preview -- --host 127.0.0.1 --port 5179
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
