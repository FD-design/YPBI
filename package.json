{
  "name": "config-driven-bi-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "bun --watch server/index.ts",
    "start:server": "bun server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test src server",
    "test:coverage": "bun test src server --coverage",
    "test:e2e": "playwright test qa-small-drawer.spec.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "echarts": "^6.1.0",
    "fastify": "^5.12.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "overrides": {
    "fast-uri": "^4.1.2",
    "find-my-way": "^9.6.1",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23"
  }
}
